def transformDigits(n):
    result = 0
    place = 1

    while n > 0:
        digit = n % 10

        if digit % 2 == 0:
            digit += 1
        else:
            digit -= 1

        result += digit * place
        place *= 10
        n //= 10

    return result

n = int(input())
print(transformDigits(n))
